xsolutionsmd.com {
    root * /srv
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    file_server
    @version path /version.json
    header @version Cache-Control "no-store"
}

# Container health endpoint; not published on the host.
:8081 {
    root * /srv
    file_server
}

www.xsolutionsmd.com {
    redir https://xsolutionsmd.com{uri} permanent
}
